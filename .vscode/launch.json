{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run cava-sunday-vm",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cava-sunday-vm",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: build",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
